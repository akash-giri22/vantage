# Google Gemini
GEMINI_API_KEY=

# Indeed Partner API (optional; requires approved Indeed access)
INDEED_ACCESS_TOKEN=

# Adzuna API (optional; register at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Firebase
FIREBASE_PROJECT_ID=

# Database (Supabase or Neon free Postgres)
DATABASE_URL=

# Max application attempts per day
DAILY_APPLY_CAP=7

# Optional notifications
NOTIFICATION_EMAIL=
